#Este é um arquivo .gitignore clássico e bastante completo para projetos#
#Python que utilizam o framework Django. Ele serve para instruir o Git# 
#a ignorar arquivos temporários, de ambiente, de configuração local #
#e de build que não devem ser enviados para o repositório remoto #
#(como o GitHub).#


# Django #
*.log                     # Ignora arquivos de log gerados pela aplicação
*.pot                     # Ignora arquivos de tradução temporários (Gettext POT)
*.pyc                     # Ignora arquivos compilados do Python
__pycache__               # Ignora a pasta de cache do compilador bytecode do Python
db.sqlite3                # Ignora o banco de dados SQLite local de desenvolvimento
media                     # Ignora a pasta de arquivos de mídia enviados por usuários

# Backup files #
*.bak                     # Ignora arquivos de backup criados por editores ou sistemas

# Python #
*.py[cod]                 # Ignora arquivos compilados (.pyc, .pyo, .pyd)
*$py.class                # Ignora classes compiladas para Jython

# Distribution / packaging
.Python build/            # Ignora pastas de build e o interpretador local Python
develop-eggs/             # Ignora pastas de pacotes de desenvolvimento setuptools
dist/                     # Ignora a pasta de distribuição final do pacote
downloads/                # Ignora pastas de downloads temporários
eggs/                     # Ignora arquivos Eggs de pacotes Python antigos
.eggs/                    # Ignora o diretório de cache de eggs
lib/                      # Ignora pastas de bibliotecas locais
lib64/                    # Ignora pastas de bibliotecas locais de 64 bits
parts/                    # Ignora diretórios do Buildout
sdist/                    # Ignora pacotes de código-fonte (Source Distribution)
var/                      # Ignora diretórios de dados variáveis
wheels/                   # Ignora arquivos de pacotes compilados Wheel (.whl)
*.egg-info/               # Ignora metadados de pacotes eggs
.installed.cfg            # Ignora arquivo de configuração gerado pelo Buildout
*.egg                     # Ignora arquivos individuais de empacotamento .egg
*.manifest                # Ignora arquivos de manifesto de empacotamento
*.spec                    # Ignora arquivos de especificação (ex: PyInstaller)

# Installer logs
pip-log.txt               # Ignora o arquivo de log gerado pelo gerenciador pip
pip-delete-this-directory.txt # Ignora arquivos temporários de remoção do pip

# Unit test / coverage reports
htmlcov/                  # Ignora relatórios de cobertura de testes em HTML
.tox/                     # Ignora diretórios da ferramenta de testes Tox
.coverage                 # Ignora dados brutos de cobertura de código
.coverage.*               # Ignora arquivos particionados de cobertura
.cache                    # Ignora diretórios gerais de cache
.pytest_cache/            # Ignora o cache do framework de testes Pytest
nosetests.xml             # Ignora relatórios XML do Nose tests
coverage.xml              # Ignora relatórios XML de cobertura
*.cover                   # Ignora arquivos individuais de cobertura de código
.hypothesis/              # Ignora dados da biblioteca de testes baseados em propriedades Hypothesis

# Jupyter Notebook
.ipynb_checkpoints        # Ignora arquivos de checkpoints salvos automaticamente pelo Jupyter

# pyenv
.python-version           # Ignora arquivo que define a versão fixa do Python via pyenv

# celery
celerybeat-schedule.*     # Ignora arquivos de agendamento de tarefas em segundo plano (Celery Beat)

# SageMath parsed files
*.sage.py                 # Ignora arquivos gerados pelo sistema SageMath

# Environments
.env                      # Ignora variáveis de ambiente sensíveis (senhas, chaves secretas)
.venv                     # Ignora o ambiente virtual Python padrão
env/                      # Ignora pastas alternativas de ambiente virtual
venv/                     # Ignora pastas alternativas de ambiente virtual
ENV/                      # Ignora pastas alternativas de ambiente virtual (maiúsculas)
env.bak/                  # Ignora backups de ambientes virtuais
venv.bak/                 # Ignora backups de ambientes virtuais

# mkdocs documentation
/site                     # Ignora a pasta de saída gerada pelo gerador de documentação MkDocs

# mypy
.mypy_cache/              # Ignora o cache do verificador estático de tipos Mypy

# Sublime Text #
*.tmlanguage.cache        # Ignora cache de linguagem do editor Sublime Text
*.tmPreferences.cache     # Ignora cache de preferências do Sublime Text
*.stTheme.cache           # Ignora cache de temas do Sublime Text
*.sublime-workspace       # Ignora o espaço de trabalho pessoal do Sublime Text
*.sublime-project         # Ignora o arquivo de projeto local do Sublime Text

# sftp configuration file
sftp-config.json          # Ignora configurações de conexão FTP/SFTP do editor

# Package control specific files Package
Control.last-run          # Ignora arquivos de controle de pacotes do Sublime
Control.ca-list           # Ignora certificados locais do Sublime
Control.ca-bundle         # Ignora pacotes de certificados do Sublime
Control.system-ca-bundle  # Ignora pacotes de certificados do sistema no editor
GitHub.sublime-settings   # Ignora configurações do plugin GitHub para Sublime

# Visual Studio Code #
.vscode/*                 # Ignora configurações gerais da pasta .vscode
!.vscode/settings.json    # Exceção: Mantém as configurações compartilhadas do projeto no VS Code
!.vscode/tasks.json       # Exceção: Mantém as tarefas de automação compartilhadas
!.vscode/launch.json      # Exceção: Mantém as configurações de depuração compartilhadas
!.vscode/extensions.json  # Exceção: Mantém a lista de extensões recomendadas para o time
.history                  # Ignora o histórico local de alterações do VS Code

# Personal additions
__pycache__/              # Duplicado: Garante que o cache do Python seja ignorado
*.pyc                     # Duplicado: Garante que arquivos .pyc sejam ignorados
__localcode               # Ignora pasta/arquivo de códigos ou rascunhos locais pessoais
venv                      # Duplicado: Garante que o ambiente virtual principal seja ignorado
env                       # Duplicado: Garante que o ambiente virtual alternativo seja ignorado
.DS_Store                 # Ignora arquivos invisíveis de cache de pastas do sistema macOS
local_settings.py         # Ignora configurações locais do Django (senhas de banco, DEBUG=True)
_local_settings.py        # Ignora outra variação de arquivo de configurações locais
gunicorn-error-log        # Ignora o arquivo de log de erros do servidor WSGI Gunicorn
db.sqlite3                # Duplicado: Garante que o banco SQLite local seja ignorado
db copy.sqlite3           # Ignora cópias de backup manuais do banco de dados SQLite
static/                   # Ignora a pasta de arquivos estáticos coletados (geralmente gerada por 'collectstatic')